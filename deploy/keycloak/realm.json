  "clients": [
    {
      "clientId": "stator",
      "name": "Stator",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "stator-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost*",
        "http://127.0.0.1*",
        "http://web/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
