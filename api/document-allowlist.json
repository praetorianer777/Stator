          "enum": [
            "open",
            "done",
            "all"
          ]
        }
      }
    },
    "templateButton": {
      "attrs": {
        "label": {
          "kind": "string",
          "maxLength": 80
        },
        "parent": {
          "kind": "string",
          "nullable": true,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "space": {
          "kind": "string",
          "nullable": true,
          "pattern": "^[A-Z][A-Z0-9]{1,9}$"
        },
        "template": {
          "kind": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "kind": "string",
          "maxLength": 255
        }
      }
    },
    "text": {
      "inline": true
    }
  },
  "marks": {
    "bold": {},
    "code": {},
    "hint": {},
    "inlineComment": {
      "attrs": {
        "threadId": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "repeatable": true
    },
    "italic": {},
    "link": {
      "attrs": {
        "class": {
          "kind": "null"
        },
        "href": {
          "kind": "string",
          "maxLength": 2048,
          "url": true
        },
        "rel": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "noopener noreferrer nofollow"
          ]
        },
        "target": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "_blank"
          ]
        },
        "title": {
          "kind": "string",
          "nullable": true,
          "maxLength": 256
        }
      }
    },
    "strike": {}
  }
}
