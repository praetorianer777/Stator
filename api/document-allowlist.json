{
  "nodes": {
    "armatureIssue": {
      "attrs": {
        "key": {
          "kind": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,17}$"
        }
      },
      "inline": true
    },
    "armatureIssueBlock": {
      "attrs": {
        "key": {
          "kind": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,17}$"
        }
      }
    },
    "attachment": {
      "attrs": {
        "attachmentId": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "fileName": {
          "kind": "string",
          "maxLength": 200,
          "pattern": "\\S"
        }
      },
      "inline": true
    },
    "blockquote": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "bulletList": {
      "content": [
        "listItem"
      ]
    },
    "childPages": {
      "attrs": {
        "depth": {
          "kind": "integer",
          "nullable": true,
          "min": 1,
          "max": 10
        },
        "scope": {
          "kind": "string",
          "enum": [
            "children",
            "subtree"
          ]
        },
        "sort": {
          "kind": "string",
          "enum": [
            "tree",
            "title",
            "updated"
          ]
        }
      }
    },
    "codeBlock": {
      "attrs": {
        "language": {
          "kind": "string",
          "nullable": true,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9+#-]*$"
        }
      },
      "content": [
        "text"
      ]
    },
    "doc": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "hardBreak": {
      "inline": true
    },
    "heading": {
      "attrs": {
        "id": {
          "kind": "string",
          "nullable": true,
          "maxLength": 80,
          "pattern": "^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{N}]+(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{N}]+)*$"
        },
        "level": {
          "kind": "integer",
          "min": 1,
          "max": 3
        }
      },
      "content": [
        "text",
        "hardBreak",
        "mention",
        "attachment",
        "armatureIssue"
      ],
      "allowsMarks": true
    },
    "horizontalRule": {},
    "image": {
      "attrs": {
        "alt": {
          "kind": "string",
          "nullable": true,
          "maxLength": 500
        },
        "attachmentId": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "width": {
          "kind": "integer",
          "nullable": true,
          "min": 1,
          "max": 4000
        }
      }
    },
    "listItem": {
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "mention": {
      "attrs": {
        "id": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "label": {
          "kind": "string",
          "maxLength": 256,
          "pattern": "\\S"
        },
        "mentionSuggestionChar": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "@"
          ]
        }
      },
      "inline": true
    },
    "orderedList": {
      "attrs": {
        "start": {
          "kind": "integer",
          "max": 1000000
        },
        "type": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "1",
            "a",
            "A",
            "i",
            "I"
          ]
        }
      },
      "content": [
        "listItem"
      ]
    },
    "panel": {
      "attrs": {
        "kind": {
          "kind": "string",
          "enum": [
            "info",
            "note",
            "success",
            "warning",
            "error"
          ]
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "paragraph": {
      "content": [
        "text",
        "hardBreak",
        "mention",
        "attachment",
        "armatureIssue"
      ],
      "allowsMarks": true
    },
    "table": {
      "content": [
        "tableRow"
      ]
    },
    "tableCell": {
      "attrs": {
        "align": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "background": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "neutral",
            "accent",
            "success",
            "warning",
            "danger"
          ]
        },
        "colspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        },
        "colwidth": {
          "kind": "integers",
          "nullable": true,
          "max": 4000,
          "maxLength": 100
        },
        "rowspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "tableHeader": {
      "attrs": {
        "align": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "background": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "neutral",
            "accent",
            "success",
            "warning",
            "danger"
          ]
        },
        "colspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        },
        "colwidth": {
          "kind": "integers",
          "nullable": true,
          "max": 4000,
          "maxLength": 100
        },
        "rowspan": {
          "kind": "integer",
          "min": 1,
          "max": 100
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "tableOfContents": {
      "attrs": {
        "maxLevel": {
          "kind": "integer",
          "min": 1,
          "max": 3
        }
      }
    },
    "tableRow": {
      "content": [
        "tableCell",
        "tableHeader"
      ]
    },
    "taskItem": {
      "attrs": {
        "checked": {
          "kind": "boolean"
        }
      },
      "content": [
        "paragraph",
        "heading",
        "bulletList",
        "orderedList",
        "taskList",
        "blockquote",
        "codeBlock",
        "horizontalRule",
        "table",
        "panel",
        "image",
        "tableOfContents",
        "childPages",
        "armatureIssueBlock"
      ]
    },
    "taskList": {
      "content": [
        "taskItem"
      ]
    },
    "text": {
      "inline": true
    }
  },
  "marks": {
    "bold": {},
    "code": {},
    "hint": {},
    "inlineComment": {
      "attrs": {
        "threadId": {
          "kind": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "repeatable": true
    },
    "italic": {},
    "link": {
      "attrs": {
        "class": {
          "kind": "null"
        },
        "href": {
          "kind": "string",
          "maxLength": 2048,
          "url": true
        },
        "rel": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "noopener noreferrer nofollow"
          ]
        },
        "target": {
          "kind": "string",
          "nullable": true,
          "enum": [
            "_blank"
          ]
        },
        "title": {
          "kind": "string",
          "nullable": true,
          "maxLength": 256
        }
      }
    },
    "strike": {}
  }
}
